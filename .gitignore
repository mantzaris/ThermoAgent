# Raw runtime artifacts are copied back from the RunPod when needed.
runs/

# Research results are intentionally Git-facing. Ignore only heavyweight or
# regenerable payloads within that tree.
results/checkpoints/*.optimizer.pt
results/logs/**/*.raw.log
results/networks/animations/*.mp4
results/**/checkpoints/*.optimizer.pt
results/**/logs/**/*.raw.log
results/**/networks/animations/*.mp4
results/**/.staging/
results/**/*.safetensors
results/**/*.tmp
results/.staging/

