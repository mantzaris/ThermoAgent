results/JSTAT/**/*.npz
results/JSTAT/**/*.pkl
results/JSTAT/**/*.pickle
results/JSTAT/**/*.safetensors
results/JSTAT/**/*.pt
results/JSTAT/**/*.bin
results/JSTAT/**/*.tar
results/JSTAT/**/*.tar.*
results/JSTAT/**/*.zip
results/JSTAT/**/*.tmp
results/JSTAT/**/*.raw.log

# Model caches and local providers are never repository artifacts.
.cache/
huggingface/
models/

# LaTeX intermediates; the final manuscript PDF is retained.
paper/JSTAT/*.aux
paper/JSTAT/*.bbl
paper/JSTAT/*.blg
paper/JSTAT/*.fdb_latexmk
paper/JSTAT/*.fls
paper/JSTAT/*.log
