{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "thermohitl-human-trial-v1",
  "title": "Future IRB-approved ThermoHITL trial record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trial_id", "pseudonymous_participant_id", "condition", "application",
    "scenario_id", "scenario_seed", "operator_view_sha256", "started_at",
    "ended_at", "actions", "technical_status"
  ],
  "properties": {
    "trial_id": {"type": "string"},
    "pseudonymous_participant_id": {"type": "string"},
    "condition": {"enum": ["local_kpi", "thermodynamic", "thermodynamic_disagreement"]},
    "application": {"enum": ["commercial", "humanitarian"]},
    "scenario_id": {"type": "string"},
    "scenario_seed": {"type": "integer"},
    "operator_view_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "shown_at_ms", "selected_at_ms", "result"],
        "properties": {
          "action": {"type": "string"},
          "shown_at_ms": {"type": "integer", "minimum": 0},
          "selected_at_ms": {"type": "integer", "minimum": 0},
          "result": {"type": "string"}
        }
      }
    },
    "workload_questionnaire": {"type": ["object", "null"]},
    "technical_status": {"enum": ["complete", "failed_retained", "withdrawn"]},
    "failure_reason": {"type": ["string", "null"]}
  }
}

