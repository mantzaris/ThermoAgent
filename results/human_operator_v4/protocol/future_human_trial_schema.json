{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Prospective data schema only; ThermoHITL v4 contains no human trial rows.",
  "properties": {
    "action_available": {"items": {"type": "string"}, "type": "array"},
    "action_selected": {"type": ["string", "null"]},
    "calibration_probability": {"maximum": 1, "minimum": 0, "type": ["number", "null"]},
    "condition": {"enum": ["local_kpi_only", "kpi_plus_entropy_disagreement"]},
    "decision_time_ms": {"minimum": 0, "type": "integer"},
    "environment_panel_id": {"minLength": 1, "type": "string"},
    "nasa_tlx": {"additionalProperties": {"maximum": 100, "minimum": 0, "type": "number"}, "type": ["object", "null"]},
    "participant_id": {"minLength": 1, "type": "string"},
    "response_timestamp_utc": {"format": "date-time", "type": "string"},
    "scenario_order": {"minimum": 1, "type": "integer"},
    "service_outcome": {"type": ["number", "null"]},
    "trial_id": {"minLength": 1, "type": "string"},
    "view_payload_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
  },
  "required": [
    "trial_id",
    "participant_id",
    "environment_panel_id",
    "condition",
    "scenario_order",
    "view_payload_sha256",
    "action_available",
    "action_selected",
    "decision_time_ms",
    "response_timestamp_utc"
  ],
  "title": "Future ThermoHITL human trial record",
  "type": "object"
}
